<?xml version="1.0"?>
<!--
  rp1 MVP description: the 4 drive wheels, skid-steer, no steering joints.

  GEOMETRY IS PLACEHOLDER. track width 0.5 m, wheelbase 0.5 m, wheel radius 0.1 m are the same
  round numbers the old rp1_control/rp1_sim configs carried, kept only so the tree is
  well-formed. Real values are what docs/mechanical_request.{pdf,xlsx} asks mechanical design
  for -- §3.1 for the wheel layout, §3.3.2 for the loaded rolling radius. Update here AND in
  rp1_bringup/config/rp1_controllers.yaml (diff_drive_controller takes wheel_separation and
  wheel_radius as its own parameters, it does not read them from this file).

  base_link is at the ground projection of the geometric centre of the four wheel contact
  patches, X forward / Y left / Z up (REP-103) -- the convention §1 of the mechanical request
  asks mechanical design to confirm.

  Steering actuators are deliberately NOT in this description: the same Rp1Hardware component
  handles them (see rp1_steering.urdf), but including them here would broadcast an
  actuator.ArrayCommand every cycle with whatever the unclaimed command interface holds, at
  wheels that have no encoder yet. Add them when the swerve controller exists.
-->
<robot name="rp1">
  <link name="base_link"/>

  <!-- Drive wheels. esc_index is the value set on that VESC's "UAVCAN ESC index" field in VESC
       Tool; it must match docs/can_id_map.md's wheel index table. -->
  <link name="wheel_front_left_link"/>
  <joint name="drive_front_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.25 0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_front_right_link"/>
  <joint name="drive_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.25 -0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_left_link"/>
  <joint name="drive_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.25 0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right_link"/>
  <joint name="drive_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.25 -0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="rp1_drive" type="system">
    <hardware>
      <plugin>rp1_hardware_interface/Rp1Hardware</plugin>
      <param name="can_iface">can0</param>
      <param name="node_id">42</param>
      <!-- Motor revolutions per wheel revolution. PLACEHOLDER: §3.4.5 of the mechanical
           request. 1.0 means direct drive. -->
      <param name="gear_ratio">1.0</param>
      <!-- si_motor_poles / 2 from the VESC motor configuration. PLACEHOLDER: read it off the
           motor detection results in VESC Tool. -->
      <param name="motor_pole_pairs">7.0</param>
      <!-- VESC firmware is asymmetric about RPM units on the wire: esc.Status.rpm is divided by
           pole pairs before sending (mechanical RPM), but handle_esc_rpm_command() feeds
           RPMCommand straight into mc_interface_set_pid_speed() as ERPM. true compensates for
           that. Set false only after the firmware fork scales the command side too. -->
      <param name="command_rpm_is_erpm">true</param>
    </hardware>

    <joint name="drive_front_left">
      <param name="esc_index">0</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_front_right">
      <param name="esc_index">1</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_left">
      <param name="esc_index">2</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_right">
      <param name="esc_index">3</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <!-- Per-ESC telemetry from the same esc.Status messages. Reaches /dynamic_joint_states via
         joint_state_broadcaster; rp1_elrs turns it into the handset's BatteryState. -->
    <gpio name="esc_front_left">
      <param name="esc_index">0</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_front_right">
      <param name="esc_index">1</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_left">
      <param name="esc_index">2</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_right">
      <param name="esc_index">3</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
  </ros2_control>
</robot>
