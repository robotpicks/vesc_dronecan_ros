<?xml version="1.0"?>
<!--
  Worked example: 4 driven wheels on one CAN bus, skid-steer, no steered joints.

  This is documentation, not a robot. Geometry is round numbers. Copy it into your own
  <robot>_description package and edit; do not depend on this file from a launch file.

  Every parameter the hardware component reads is exercised here. The two that most often go
  wrong are motor_pole_pairs and command_rpm_is_erpm -- see the README's "RPM units" section
  before trusting the values you get back.
-->
<robot name="example_4wheel">
  <link name="base_link"/>

  <link name="wheel_front_left_link"/>
  <joint name="drive_front_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.25 0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_front_right_link"/>
  <joint name="drive_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.25 -0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_left_link"/>
  <joint name="drive_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.25 0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rear_right_link"/>
  <joint name="drive_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.25 -0.25 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="example_4wheel" type="system">
    <hardware>
      <plugin>vesc_dronecan_driver/VescDroneCanSystem</plugin>

      <!-- SocketCAN interface to bind. Use vcan0 to run against a virtual bus.
           NOTE: ros2_control reads hardware parameters from the robot description only, so this
           cannot be overridden as a node parameter. To make it switchable, rewrite this string
           in your launch file before handing the description to robot_state_publisher. -->
      <param name="can_iface">can0</param>

      <!-- This component's own DroneCAN node ID. Must be unique on the bus, and must not
           collide with any VESC's CAN ID (which doubles as its node ID in VESC+UAVCAN mode). -->
      <param name="node_id">42</param>

      <!-- Motor revolutions per wheel revolution. 1.0 is direct drive. -->
      <param name="gear_ratio">1.0</param>

      <!-- si_motor_poles / 2, read off the motor detection results in VESC Tool. -->
      <param name="motor_pole_pairs">7.0</param>

      <!-- Compensates for the firmware's asymmetric RPM units: esc.Status.rpm is divided by pole
           pairs before transmission (mechanical RPM), but handle_esc_rpm_command() feeds
           RPMCommand straight into mc_interface_set_pid_speed() as ERPM. Set false only if your
           firmware scales the command side too. See the README. -->
      <param name="command_rpm_is_erpm">true</param>
    </hardware>

    <!-- A joint with "esc_index" is a driven wheel: velocity command, esc.RPMCommand/Status.
         esc_index is that VESC's "UAVCAN ESC index" field in VESC Tool. -->
    <joint name="drive_front_left">
      <param name="esc_index">0</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_front_right">
      <param name="esc_index">1</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_left">
      <param name="esc_index">2</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="drive_rear_right">
      <param name="esc_index">3</param>
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <!-- A steered joint would instead declare "actuator_id" and a position interface:

           <joint name="steering_front_left">
             <param name="actuator_id">4</param>
             <command_interface name="position"/>
             <state_interface name="position"/>
             <state_interface name="velocity"/>
           </joint>

         Declaring both esc_index and actuator_id on one joint, or neither, is a hard error at
         on_init(). Steering also requires firmware with actuator.ArrayCommand support -- see the
         README. -->

    <!-- Per-ESC pack telemetry, keyed to a wheel by the same esc_index. Reaches
         /dynamic_joint_states via joint_state_broadcaster, but ONLY if that controller is
         configured with publish_dynamic_joint_states: true and use_urdf_to_filter: false. Both
         default to dropping these silently. -->
    <gpio name="esc_front_left">
      <param name="esc_index">0</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_front_right">
      <param name="esc_index">1</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_left">
      <param name="esc_index">2</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
    <gpio name="esc_rear_right">
      <param name="esc_index">3</param>
      <state_interface name="voltage"/>
      <state_interface name="current"/>
      <state_interface name="temperature"/>
    </gpio>
  </ros2_control>
</robot>
